{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "WhatsApp AI Assistant",
    "description": "HTTP control API for WhatsApp AI Assistant.\n\nSet collection variables before use:\n- `baseUrl` (default: http://localhost:8000)\n- `apiKey` (must match ARS_API_KEY in .env)\n\nDocs: docs/API.md",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "apiKey",
      "value": "your_secret_api_key"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Public liveness probe. No authentication required.\n\n**200**\n```json\n{ \"success\": true, \"message\": \"OK\" }\n```"
          },
          "response": [
            {
              "name": "OK",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/health",
                  "host": ["{{baseUrl}}"],
                  "path": ["health"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"OK\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "AI Status",
      "item": [
        {
          "name": "Get AI status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["status"]
            },
            "description": "Returns whether AI auto-replies are enabled.\n\nRequires header `x-api-key` = `ARS_API_KEY`.\n\n**200**\n```json\n{ \"Message\": \"Welcome\", \"aiEnabled\": true }\n```\n\n**401**\n```json\n{ \"success\": false, \"message\": \"Unauthorized\" }\n```"
          },
          "response": [
            {
              "name": "Enabled",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "x-api-key",
                    "value": "{{apiKey}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/status",
                  "host": ["{{baseUrl}}"],
                  "path": ["status"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"Message\": \"Welcome\",\n  \"aiEnabled\": true\n}"
            },
            {
              "name": "Unauthorized",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/status",
                  "host": ["{{baseUrl}}"],
                  "path": ["status"]
                }
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": false,\n  \"message\": \"Unauthorized\"\n}"
            }
          ]
        },
        {
          "name": "Enable AI",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["status"]
            },
            "description": "Turns AI auto-replies **on** for private WhatsApp chats.\n\n**Body**\n```json\n{ \"enabled\": true }\n```\n\n**200**\n```json\n{ \"success\": true, \"aiEnabled\": true }\n```"
          },
          "response": [
            {
              "name": "Enabled",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "x-api-key",
                    "value": "{{apiKey}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"enabled\": true\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/status",
                  "host": ["{{baseUrl}}"],
                  "path": ["status"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"aiEnabled\": true\n}"
            }
          ]
        },
        {
          "name": "Disable AI",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["status"]
            },
            "description": "Turns AI auto-replies **off**. Incoming private messages may still be stored; no AI reply is sent.\n\n**Body**\n```json\n{ \"enabled\": false }\n```\n\n**200**\n```json\n{ \"success\": true, \"aiEnabled\": false }\n```"
          },
          "response": [
            {
              "name": "Disabled",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "x-api-key",
                    "value": "{{apiKey}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"enabled\": false\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/status",
                  "host": ["{{baseUrl}}"],
                  "path": ["status"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"success\": true,\n  \"aiEnabled\": false\n}"
            }
          ]
        }
      ]
    }
  ]
}
